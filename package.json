{
  "name": "numbertales-misskey-ai-bot",
  "version": "0.1.0",
  "description": "ナンバーテールズ各個体を模した Misskey AI Bot（000(チトセ) を主軸とし、公開済みキャラクターへのマルチキャラクター対応）",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "nodemon --exec ts-node src/index.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write src/**/*.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "misskey-js": "^2025.2.0",
    "openai": "^4.0.0",
    "@google/generative-ai": "^0.24.0",
    "mathjs": "^15.2.0",
    "dotenv": "^16.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0",
    "nodemon": "^3.0.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "prettier": "^3.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "CC-BY-NC-4.0"
}
