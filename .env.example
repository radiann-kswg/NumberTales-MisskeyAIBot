# ================================================
# NumberTales Misskey AI Bot — 環境変数テンプレート
# ================================================
# このファイルをコピーして .env にリネームし、各値を設定してください。
# .env は .gitignore で管理対象外にしてあります。絶対にコミットしないこと。

# ------------------------------------------------
# Misskey 接続設定
# ------------------------------------------------
# BotアカウントのMisskeyインスタンスURL（末尾スラッシュなし）
MISSKEY_HOST=https://your-instance.example.com

# BotアカウントのAPIアクセストークン
# Misskeyの「設定 > APIトークン」から発行してください
MISSKEY_TOKEN=your_misskey_api_token

# ------------------------------------------------
# AI API設定
# ------------------------------------------------
# 使用するAIプロバイダー（openai / gemini）
AI_PROVIDER=openai

# OpenAI APIキー（AI_PROVIDER=openai 時に使用）
OPENAI_API_KEY=your_openai_api_key

# Google Gemini APIキー（AI_PROVIDER=gemini 時に使用）
GEMINI_API_KEY=your_gemini_api_key

# ------------------------------------------------
# ストレージ設定
# ------------------------------------------------
# SQLiteデータベースのファイルパス（相対パス可）
DB_PATH=.cache/session.db

# ハートビートファイルの出力先（VM内ウォッチドッグが鮮度を監視・省略可）
HEARTBEAT_PATH=.cache/heartbeat.json

# ハートビート書き込み間隔ミリ秒（省略可・デフォルト30秒）
HEARTBEAT_INTERVAL_MS=30000

# ------------------------------------------------
# 復旧通知（ダウンタイム明けの自発投稿・すべて省略可）
# ------------------------------------------------
# この時間以上停止していた場合のみ復旧通知を投稿（既定30分）
DOWNTIME_NOTICE_THRESHOLD_MS=1800000

# 復旧通知のクールダウン。この期間内は再投稿しない（クラッシュループ対策・既定6時間）
DOWNTIME_NOTICE_COOLDOWN_MS=21600000

# 復旧通知の上限。これを超える停止は投稿しない（古いheartbeat復活の誤検知除け・既定7日）
DOWNTIME_NOTICE_MAX_MS=604800000

# ------------------------------------------------
# Bot動作設定
# ------------------------------------------------
# 実行環境（development / production）
# 本番環境（GCP VM 等）では production に変更すること
NODE_ENV=development

# ログレベル（error / warn / info / debug）
LOG_LEVEL=info

# マルチキャラクター機能の標準担当番号（個別指定がない場合に使用）
DEFAULT_CHARACTER_NUM=000

# 管理者ユーザーIDのカンマ区切り一覧
# 例: ADMIN_USER_IDS=9abcdexyz,1fghijklm
ADMIN_USER_IDS=

# ------------------------------------------------
# レートリミット設定（ミリ秒）
# ------------------------------------------------
# 同一ユーザーへのリプライのクールダウン（デフォルト: 30分）
RATE_LIMIT_REPLY_COOLDOWN_MS=1800000

# 1時間あたりの全体投稿数上限（安全弁）。ヒット＆ブロウ・ヨットの手番継続はこの上限のカウント対象外
RATE_LIMIT_GLOBAL_PER_HOUR=30

# ------------------------------------------------
# 機能フラグ
# ------------------------------------------------
# グローバルTL ハッシュタグ検出リアクション機能の有効化（デフォルト: 無効）
# true にすると #ナンバーテールズ 等を含む投稿にリアクションを送る
ENABLE_GLOBAL_TL=false
